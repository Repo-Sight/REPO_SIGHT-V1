{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:analyser",
  "outputDirectory": "frontend",
  "functions": {
    "api/analyze.js": {
      "includeFiles": "backend/bin/**",
      "maxDuration": 60
    },
    "api/analyze-file.js": {
      "includeFiles": "backend/bin/**",
      "maxDuration": 15
    },
    "api/scans/[scanId].js": {
      "maxDuration": 10
    },
    "api/feedback.js": {
      "maxDuration": 10
    }
  }
}
