{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npm --prefix frontend install",
  "buildCommand": "npm run build:analyser && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/analyze.js": {
      "includeFiles": "backend/bin/**",
      "maxDuration": 60
    },
    "api/analyze-file.js": {
      "includeFiles": "backend/bin/**",
      "maxDuration": 15
    },
    "api/analyze-diff.js": {
      "includeFiles": "backend/bin/**",
      "maxDuration": 15
    },
    "api/scans/[scanId].js": {
      "maxDuration": 10
    },
    "api/feedback.js": {
      "maxDuration": 10
    },
    "api/rules.js": {
      "maxDuration": 10
    },
    "api/badge/[scanId].js": {
      "maxDuration": 10
    },
    "api/explain-finding.js": {
      "maxDuration": 25
    },
    "api/keepalive.js": {
      "maxDuration": 10
    }
  }
}
